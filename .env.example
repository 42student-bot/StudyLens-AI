# Copiez ce fichier en /etc/studylens/env (serveur) ou .env (local) et remplissez-le.
# NE JAMAIS le versionner sur GitHub.

# --- Stockage ---
DATA_DIR=/var/lib/studylens

# --- Meta / Messenger (voir README, section « Configurer Meta ») ---
FB_APP_SECRET=
FB_PAGE_TOKEN=
FB_VERIFY_TOKEN=choisissez-une-longue-chaine-aleatoire
# Vide = URL Graph non versionnée. Vous pouvez fixer une version (ex. v24.0) après avoir vérifié laquelle est disponible.
GRAPH_API_VERSION=
# Vos identifiants Messenger (PSID), séparés par des virgules. Sans cela, personne n'est autorisé.
ALLOWED_PSIDS=

# --- Fournisseurs IA ---
PRIMARY_PROVIDER=gemini
FALLBACK_PROVIDER=
# Les fournisseurs payants sont ignorés tant que ALLOW_PAID_PROVIDERS n'est pas true
ALLOW_PAID_PROVIDERS=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# true UNIQUEMENT si vous avez vérifié que votre usage reste dans le palier gratuit
GEMINI_FREE_TIER=false
# Prix par million de tokens (nécessaires si GEMINI_FREE_TIER=false et ALLOW_PAID_PROVIDERS=true)
GEMINI_PRICE_IN_PER_MTOK=
GEMINI_PRICE_OUT_PER_MTOK=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# À renseigner d'après la grille tarifaire officielle (même devise que les budgets)
ANTHROPIC_PRICE_IN_PER_MTOK=
ANTHROPIC_PRICE_OUT_PER_MTOK=

# --- Budget (même unité que les prix ci-dessus) ---
BUDGET_DAILY=0.50
BUDGET_MONTHLY=5.00
MAX_REQUESTS_PER_DAY=120
MAX_SESSIONS_PER_DAY=30

# --- Comportement ---
AUTO_ANALYZE_DELAY=25     # secondes sans nouvelle photo avant l'analyse
MAX_PAGES=20
SCREEN_CHARS=450          # taille max d'un message : à ajuster selon votre écran
BLUR_THRESHOLD=60         # plus haut = plus strict ; à calibrer avec scripts.analyze_files
VERIFY_WITH_LLM=true

# --- Confidentialité ---
DELETE_IMAGES_AFTER_ANALYSIS=true
IMAGE_RETENTION_MINUTES=120
SESSION_RETENTION_HOURS=48
KEEP_HISTORY=false
